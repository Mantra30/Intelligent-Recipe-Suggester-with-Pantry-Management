<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smartrecipes.controllers.SuggestionController">
   <top>
      <VBox spacing="10.0">
         <children>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="💡 Smart Recipe Suggestions" textAlignment="CENTER">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Text>
            <HBox spacing="10.0">
               <children>
                  <TextField fx:id="searchField" promptText="Search suggestions..." />
                  <ComboBox fx:id="cuisineFilter" promptText="Filter by cuisine" />
                  <ComboBox fx:id="difficultyFilter" promptText="Filter by difficulty" />
                  <ComboBox fx:id="timeFilter" promptText="Filter by time" />
                  <Button fx:id="cookButton" mnemonicParsing="false" onAction="#handleCookButton" text="🍳 Cook" />
                  <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#handleRefreshButton" text="🔄 Refresh" />
               </children>
            </HBox>
            <Label fx:id="statsLabel" text="Loading suggestions..." textAlignment="CENTER" />
         </children>
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </top>
   <center>
      <HBox fx:id="suggestionContainer" spacing="20.0">
         <children>
            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
               <children>
                  <Text text="🎯 Suggested Recipes" textAlignment="CENTER">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Text>
                  <ListView fx:id="suggestionsList" prefHeight="400.0" />
               </children>
            </VBox>
            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
               <children>
                  <Text text="📝 Recipe Details" textAlignment="CENTER">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Text>
                  <ScrollPane fitToWidth="true" prefHeight="400.0">
                     <content>
                        <VBox spacing="10.0">
                           <children>
                              <Text fx:id="recipeDetailsText" text="Select a recipe to view details" />
                              <Text fx:id="matchScoreText" text="" />
                              <Text fx:id="ingredientsText" text="" />
                              <Text fx:id="stepsText" text="" />
                           </children>
                        </VBox>
                     </content>
                  </ScrollPane>
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </HBox>
   </center>
</BorderPane>
