<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smartrecipes.controllers.HistoryController">
   <top>
      <VBox spacing="10.0">
         <children>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="📊 Cooking History" textAlignment="CENTER">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Text>
            <HBox spacing="10.0">
               <children>
                  <TextField fx:id="searchField" promptText="Search history..." />
                  <ComboBox fx:id="recipeFilter" promptText="Filter by recipe" />
                  <ComboBox fx:id="timeFilter" promptText="Filter by time" />
                  <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#handleRefreshButton" text="🔄 Refresh" />
                  <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#handleDeleteButton" text="🗑️ Delete" />
                  <Button fx:id="clearButton" mnemonicParsing="false" onAction="#handleClearButton" text="🧹 Clear All" />
               </children>
            </HBox>
            <Label fx:id="statsLabel" text="Loading history..." textAlignment="CENTER" />
         </children>
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </top>
   <center>
      <HBox fx:id="historyContainer" spacing="20.0">
         <children>
            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
               <children>
                  <Text text="📋 Cooking History" textAlignment="CENTER">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Text>
                  <ListView fx:id="historyList" prefHeight="400.0" />
               </children>
            </VBox>
            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
               <children>
                  <Text text="📊 Statistics & Trends" textAlignment="CENTER">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Text>
                  <ScrollPane fitToWidth="true" prefHeight="400.0">
                     <content>
                        <VBox spacing="15.0">
                           <children>
                              <Text fx:id="statsText" text="" />
                              <Text fx:id="trendsText" text="" />
                              <Text fx:id="topRecipesText" text="" />
                           </children>
                        </VBox>
                     </content>
                  </ScrollPane>
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </HBox>
   </center>
</BorderPane>
